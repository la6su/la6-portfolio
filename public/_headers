# public/_headers — Cache-Control rules (Netlify / Cloudflare Pages format)
#
# Deploy target: justlovejazz.dev (configure your host to serve these rules).
# Netlify & Cloudflare Pages read _headers automatically. For Caddy, nginx, or
# HAProxy, translate to response headers in the serving/reverse-proxy layer.
#
# Strategy:
#   - Fingerprinted root JS/CSS/WASM (vite emits [name]-[hash].ext) → immutable, 1 year.
#     Safe because the hash changes on content change.
#   - Stable public media under /assets/projects, /assets/gltf, /assets/video
#     and /textures → always revalidate; these publicDir paths do not include
#     content hashes.
#   - /vendor/* + /fonts/* → 1 year immutable (version-pinned in repo; bump the
#     path when their content changes).
#   - /js/blog.js → revalidate daily; it is hand-written and unhashed.
#   - logo.svg, site.webmanifest, robots.txt, sitemap.xml → revalidate.
#   - All EN/RU HTML routes → revalidate (OG tags, metadata, and content).

# ── HTML entry points — always revalidate (OG tags, meta, content) ──
# Match the public extensionless URLs. Hosts apply `_headers` patterns to the
# request path; matching only the emitted `.html` file misses these routes.
/
  Cache-Control: public, max-age=0, must-revalidate
/services
  Cache-Control: public, max-age=0, must-revalidate
/works
  Cache-Control: public, max-age=0, must-revalidate
/works/*
  Cache-Control: public, max-age=0, must-revalidate
/manifesto
  Cache-Control: public, max-age=0, must-revalidate
/lab
  Cache-Control: public, max-age=0, must-revalidate
/contact
  Cache-Control: public, max-age=0, must-revalidate
/blog
  Cache-Control: public, max-age=0, must-revalidate
/blog/*
  Cache-Control: public, max-age=0, must-revalidate
/ru
  Cache-Control: public, max-age=0, must-revalidate
/ru/
  Cache-Control: public, max-age=0, must-revalidate
/ru/services
  Cache-Control: public, max-age=0, must-revalidate
/ru/works
  Cache-Control: public, max-age=0, must-revalidate
/ru/works/*
  Cache-Control: public, max-age=0, must-revalidate
/ru/manifesto
  Cache-Control: public, max-age=0, must-revalidate
/ru/lab
  Cache-Control: public, max-age=0, must-revalidate
/ru/contact
  Cache-Control: public, max-age=0, must-revalidate
/ru/blog
  Cache-Control: public, max-age=0, must-revalidate
/ru/blog/*
  Cache-Control: public, max-age=0, must-revalidate

# Also cover the emitted filenames for hosts which allow direct `.html` paths.
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/services.html
  Cache-Control: public, max-age=0, must-revalidate
/works.html
  Cache-Control: public, max-age=0, must-revalidate
/works/*
  Cache-Control: public, max-age=0, must-revalidate
/manifesto.html
  Cache-Control: public, max-age=0, must-revalidate
/lab.html
  Cache-Control: public, max-age=0, must-revalidate
/contact.html
  Cache-Control: public, max-age=0, must-revalidate
/blog.html
  Cache-Control: public, max-age=0, must-revalidate
/blog/*
  Cache-Control: public, max-age=0, must-revalidate

# ── Fingerprinted Vite output at the /assets root ──
/assets/:file.js
  Cache-Control: public, max-age=31536000, immutable
/assets/:file.css
  Cache-Control: public, max-age=31536000, immutable
/assets/:file.wasm
  Cache-Control: public, max-age=31536000, immutable

# ── Public media uses stable paths; revalidate when content is redeployed ──
/assets/projects/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/gltf/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/video/*
  Cache-Control: public, max-age=0, must-revalidate

# WorksSection loads /textures/sec3-particles.jpg at runtime through
# THREE.TextureLoader; the path is stable, so the browser must revalidate.
/textures/*
  Cache-Control: public, max-age=0, must-revalidate

# ── Vendored libs (version-pinned, content-addressed) ──
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# ── Hand-written blog enhancement script (unhashed, edited in place) ──
/js/blog.js
  Cache-Control: public, max-age=86400, must-revalidate

# ── Fonts (never change without a path bump) ──
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ── Static brand files — revalidate (small, may be updated) ──
/logo.svg
  Cache-Control: public, max-age=86400, must-revalidate
/preview.jpg
  Cache-Control: public, max-age=604800, must-revalidate
/site.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate
/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate

# ── Security headers (applied to all routes) ──
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
