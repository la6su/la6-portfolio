# public/_headers — Cache-Control rules (Netlify / Cloudflare Pages format)
#
# Deploy target: justlovejazz.dev (configure your host to serve these rules).
# Netlify & Cloudflare Pages read _headers automatically. For Caddy/nginx,
# translate to Cache-Control response headers.
#
# Strategy:
#   - Fingerprinted root JS/CSS/WASM (vite emits [name]-[hash].ext) → immutable, 1 year.
#     Safe because the hash changes on content change.
#   - Stable public media under /assets/projects, /assets/gltf and /assets/video
#     → always revalidate; these publicDir paths do not include content hashes.
#   - /vendor/prism/* + /js/blog.js → 1 year immutable (version-pinned in repo).
#   - logo.svg, site.webmanifest, robots.txt, sitemap.xml → revalidate.
#   - HTML (index.html, blog.html, blog/*) → no-cache (always fresh, OG tags matter).

# ── HTML entry points — always revalidate (OG tags, meta, content) ──
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/services.html
  Cache-Control: public, max-age=0, must-revalidate
/works.html
  Cache-Control: public, max-age=0, must-revalidate
/works/*
  Cache-Control: public, max-age=0, must-revalidate
/manifesto.html
  Cache-Control: public, max-age=0, must-revalidate
/lab.html
  Cache-Control: public, max-age=0, must-revalidate
/contact.html
  Cache-Control: public, max-age=0, must-revalidate
/blog.html
  Cache-Control: public, max-age=0, must-revalidate
/blog/*
  Cache-Control: public, max-age=0, must-revalidate

# ── Fingerprinted Vite output at the /assets root ──
/assets/:file.js
  Cache-Control: public, max-age=31536000, immutable
/assets/:file.css
  Cache-Control: public, max-age=31536000, immutable
/assets/:file.wasm
  Cache-Control: public, max-age=31536000, immutable

# ── Public media uses stable paths; revalidate when content is redeployed ──
/assets/projects/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/gltf/*
  Cache-Control: public, max-age=0, must-revalidate
/assets/video/*
  Cache-Control: public, max-age=0, must-revalidate

# ── Vendored libs (version-pinned, content-addressed) ──
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# ── Fonts (never change without a path bump) ──
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ── Static brand files — revalidate (small, may be updated) ──
/logo.svg
  Cache-Control: public, max-age=86400, must-revalidate
/preview.jpg
  Cache-Control: public, max-age=604800, must-revalidate
/site.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate
/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate

# ── Security headers (applied to all routes) ──
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
