{
  "name": "la6-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:hmr": "vite --host --mode hmr",
    "type-check:vue": "vue-tsc --noEmit -p tsconfig.json",
    "build": "bun run type-check:vue && bun run check:stdlib && node scripts/prerender-home.mjs && node scripts/prerender-blog.mjs && bun scripts/generate-sitemap.ts && vite build && bun scripts/check-build-budgets.ts",
    "budget:build": "bun scripts/check-build-budgets.ts",
    "analyze:bundle": "bun scripts/bundle-breakdown.ts",
    "check:stdlib": "node scripts/check-stdlib-modules.mjs",
    "preview": "vite preview",
    "test:serial": "playwright test --workers=1 --reporter=line",
    "test:matrix": "bun scripts/test-browser-matrix.ts",
    "test:host-teardown": "bun scripts/test-host-teardown.ts",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "wait:preview": "bun scripts/wait-for-url.ts http://127.0.0.1:4173/ 60000",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.3",
    "@types/three": "0.186.0",
    "@types/uikit": "^3.23.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/server-renderer": "3.5.43",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "less": "^4.9.1",
    "prettier": "^3.9.9",
    "source-map-js": "1.2.1",
    "tweakpane": "^4.0.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "8.3.2",
    "vitest": "^4.1.11",
    "vue-tsc": "3.3.11"
  },
  "description": "EN/RU portfolio built with Vue 3 and TresJS, using Three.js WebGPU/TSL with a WebGL2 fallback.",
  "dependencies": {
    "@tresjs/cientos": "5.9.2",
    "@tresjs/core": "5.9.2",
    "three": "0.186.1",
    "uikit": "^3.25.25",
    "vue": "3.5.43",
    "vue-router": "5.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/la6su/la6-portfolio.git"
  },
  "keywords": [
    "portfolio",
    "vue",
    "tresjs",
    "three.js",
    "webgpu",
    "tsl",
    "creative-development"
  ],
  "author": "la6su",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/la6su/la6-portfolio/issues"
  },
  "homepage": "https://github.com/la6su/la6-portfolio#readme"
}
