# public/_headers — Cache-Control rules (Netlify / Cloudflare Pages format)
#
# Deploy target: justlovejazz.dev (configure your host to serve these rules).
# Netlify & Cloudflare Pages read _headers automatically. For Caddy/nginx,
# translate to Cache-Control response headers (see docs/DEPLOY.md if added).
#
# Strategy:
#   - Fingerprinted assets (vite emits [name]-[hash].js/.css) → immutable, 1 year.
#     Safe because the hash changes on content change.
#   - /assets/* (project covers, fonts) → 1 year immutable (content-addressed).
#   - /vendor/prism/* + /js/blog.js → 1 year immutable (version-pinned in repo).
#   - favicon.svg, logo.svg, site.webmanifest, robots.txt, sitemap.xml → revalidate.
#   - HTML (index.html, blog.html, blog/*) → no-cache (always fresh, OG tags matter).

# ── HTML entry points — always revalidate (OG tags, meta, content) ──
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/blog.html
  Cache-Control: public, max-age=0, must-revalidate
/blog/*
  Cache-Control: public, max-age=0, must-revalidate

# ── Fingerprinted vite assets — immutable (hash in filename) ──
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# ── Vendored libs (version-pinned, content-addressed) ──
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# ── Fonts (never change without a path bump) ──
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# ── Static brand files — revalidate (small, may be updated) ──
/favicon.svg
  Cache-Control: public, max-age=86400, must-revalidate
/logo.svg
  Cache-Control: public, max-age=86400, must-revalidate
/preview.jpg
  Cache-Control: public, max-age=604800, must-revalidate
/site.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate
/robots.txt
  Cache-Control: public, max-age=86400, must-revalidate
/sitemap.xml
  Cache-Control: public, max-age=86400, must-revalidate

# ── Security headers (applied to all routes) ──
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
